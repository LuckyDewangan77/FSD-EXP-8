# Environment Configuration
# MongoDB
MONGO_URI=mongodb://localhost:27017/post_scheduler

# Kafka
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=post-scheduler
KAFKA_GROUP_ID=post-publisher-group
KAFKA_DLQ_GROUP_ID=post-dlq-group

# Topic Names
KAFKA_TOPIC_PUBLISH=post.publish.requests
KAFKA_TOPIC_DLQ=post.publish.dlq

# Scheduler
SCHEDULER_CRON=*/1 * * * *

# Retry Configuration
MAX_RETRY_ATTEMPTS=3
RETRY_BASE_DELAY_MS=1000

# App
NODE_ENV=development
LOG_LEVEL=info
